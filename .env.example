# ferry 一键启动最小配置：cp .env.example .env 后按需修改，再跑 ./deploy/start.sh。
# 完整参数集（备份/告警/恢复/调度旋钮等）见 deploy/ferry.env.example，每个旋钮都有说明。
# 本文件只列"首次启动要管的事"：端口、访问地址、存储、管理员与签名密钥。

# ---- 端口 ----
# 管理后台（dash）对外端口
FERRY_HTTP_PORT=8080
# 用户面板（panel）对外端口
FERRY_PANEL_PORT=8081

# ---- 访问地址 ----
# 对外访问地址（用于拼装展示的订阅链接）；公网部署改成 https://你的域名
FERRY_BASE_URL=http://localhost:8080

# ---- 存储 ----
# 默认 sqlite，数据落 compose 卷 ferry-data（宿主机
# /var/lib/docker/volumes/ferry-data/_data）。切 postgres 三步：
#   1) 取消下面三行注释并改成强密码
#   2) 启动命令追加 --profile postgres（./deploy/start.sh --profile postgres）
#   3) 卷 ferry-pg 首次启动自动建库，无需手工迁移
#FERRY_DB_DRIVER=postgres
#FERRY_DB_DSN=postgres://ferry:改成强密码@ferry-postgres:5432/ferry?sslmode=disable
#FERRY_PG_PASSWORD=改成强密码

# ---- 机密加密主密钥（建议配置）----
# 云 API 密钥等机密 AES-256-GCM 加密落库必须。生成：openssl rand -hex 32。
# 主密钥不入库；丢失即不可解密，请妥善备份。
# 不配置时首启自动生成并落密钥文件（库目录 ferry-keys.env，FERRY-003）。
#FERRY_SECRET_KEY=改成随机长串

# ---- 管理员首启引导（建议配置）----
# 库内无管理员时按此建号（用户名缺省 admin；已有管理员则忽略且不覆盖密码）。
#FERRY_ADMIN_USER=admin
#FERRY_ADMIN_PASSWORD=改成强密码

# ---- JWT 签名秘钥（公网必须改）----
# 缺省回落到开发期常量，仅供本机开发：公网不改则任何知道缺省值的人都能
# 自签管理员令牌。FERRY_ADMIN_SECRET 管后台登录与 /api /admin 数据面，
# FERRY_API_SECRET 管 POST /api/token 签发的 30 天自动化令牌。
# 不配置时首启自动生成并落密钥文件（重启稳定）；生产环境配开发默认常量或
# 短钥拒绝启动（FERRY_ENV=production，FERRY-003）。
#FERRY_ADMIN_SECRET=改成随机长串
#FERRY_API_SECRET=改成随机长串
