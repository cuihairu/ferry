# ferry 面板部署示例配置：cp deploy/ferry.env.example deploy/ferry.env 后按需修改。
# 启动：docker compose --env-file deploy/ferry.env -f deploy/docker-compose.yml up -d --build

# 面板对外端口
FERRY_HTTP_PORT=8080

# 对外访问地址（用于拼装展示的订阅链接）
FERRY_BASE_URL=http://localhost:8080

# 存储：默认 sqlite（compose 卷 /data/ferry.db）。
# 切 postgres：取消注释并给 compose 加 --profile postgres。
#FERRY_DB_DRIVER=postgres
#FERRY_DB_DSN=postgres://ferry:改成强密码@ferry-postgres:5432/ferry?sslmode=disable
#FERRY_PG_PASSWORD=改成强密码
# 旧别名 FERRY_DB= 仅在 FERRY_DB_DSN 未设时兜底（兼容残留，勿新用）。
#FERRY_DB=ferry.db

# 机密加密主密钥（R24 口径）：云 API 密钥等机密 AES-256-GCM 加密落库必须。
# 主密钥不入库，生成：openssl rand -hex 32；丢失即不可解密，请妥善备份。
#FERRY_SECRET_KEY=改成随机长随机串

# 管理员首启引导（安全设计 §1）：dash 登录用。库内无管理员时按此建号
#（用户名缺省 admin，已有管理员则忽略且不覆盖密码）；建议首启建号后配合
# 设置页两步验证开启 2FA。
#FERRY_ADMIN_USER=admin
#FERRY_ADMIN_PASSWORD=改成强密码

# JWT 签名秘钥（2026-10-10 数据面鉴权批）：缺省回落常量仅供本机开发，
# 公网部署必须改随机串——否则任何知道缺省值的人都能自签管理员令牌。
# ADMIN_SECRET 管 dash 登录令牌与 /api /admin 数据面；API_SECRET 管
# 程序化调用（POST /api/token 签发的 30 天自动化令牌）。
#FERRY_ADMIN_SECRET=改成随机长随机串
#FERRY_API_SECRET=改成随机长随机串

# 供给节点 agent 安装来源（OS-3 cloud-init）：下载基址与版本。
# 内网可把基址指到自建文件服务；版本对应 release tag vX.Y.Z。
#FERRY_AGENT_BASE=https://github.com/cuihairu/ferry/releases/download
#FERRY_AGENT_VERSION=latest

# 被封自动恢复与池空保底：
# 恢复流水线（BR-1/2/3）：L1 域名前置切 DNS、L2 预备机补位、L3 一键开新机。
# 模板 ID 为 dash 供给页的机型模板，0=不启用该级；周期单位秒。
#FERRY_RECOVERY_SEC=60
#FERRY_RECOVERY_TEMPLATE_ID=0
# 池空保底（BR-3）：入口池全空且无在途供给时按模板自动开新机。
#FERRY_REPLENISH_SEC=300
#FERRY_POOL_TEMPLATE_ID=0

# 证书编排（BR-4）：签发执行复用外部工具位 acme.sh（面板只做编排与续期触发）。
# 工作目录集中存证书 state；webroot 供 http-01，dns-01 走 dash 域名页的 DNS 凭证。
# 容器部署注意：ferry-server 镜像只含面板本体，不含 acme.sh / OpenTofu——
# compose 部署用证书编排/供给执行需自行把工具装进容器或挂载进去（工具位
# 设计为外部命令，路径经 FERRY_ACME_BIN/FERRY_TOFU_BIN 指向即可）。
#FERRY_ACME_BIN=acme.sh
#FERRY_ACME_HOME=/var/lib/ferry/acme
#FERRY_ACME_WEBROOT=/var/www/acme
#FERRY_CERT_SEC=21600

# 本地周期备份（面板可用性 §2）：SQLite 在线快照落备份目录，配置了主密钥
# 时打包加密（主密钥不进备份包）；cron 支持 daily / HH:MM / 标准 5 段表达式
#（robfig/cron 语法），缺省每日。滚动保留 KEEP 份（含手动下载落档）。
# 失败经 Herald backup_failed 告警。compose 部署缺省落数据卷 /data/backups。
#FERRY_BACKUP_DIR=backups
#FERRY_BACKUP_CRON=daily
#FERRY_BACKUP_KEEP=7

# 备份外发位（已接 S3 兼容端点，SigV4 PUT）：默认关闭，显式置 1 才视为
# 开启；开启后每次外发日志会明示数据范围=备份目录全部落档文件（库快照，
# 含机密密文），上传成功置 uploaded=1，失败 backup_failed 告警且本地档
# 保留。ENDPOINT 支持 http(s)://host[:port][/前缀]，兼容 MinIO 等端点。
#FERRY_BACKUP_S3_ENABLED=0
#FERRY_BACKUP_S3_ENDPOINT=
#FERRY_BACKUP_S3_BUCKET=
#FERRY_BACKUP_S3_ACCESS_KEY=
#FERRY_BACKUP_S3_SECRET_KEY=

# 外部客服（servify 嵌入，可选）：面板登录后按需加载 servify 聊天组件
#（widget.js 直嵌）。URL 为 servify 服务地址，SERVICE_KEY 为 servify
# 管理端签发的 service API key（X-API-Key，只在 ferry 服务端使用，浏览器
# 只持绑定会话的短期访客 token）。URL 或 KEY 任一为空 = 客服入口关闭，
# /api/panel/support 恒回 enabled=false，面板零外呼零组件。
#FERRY_SUPPORT_URL=
#FERRY_SUPPORT_SERVICE_KEY=

# TG bot 对接面（TOUCH-6，可选）：bot 后端调 /api/bot/* 摘要面的服务级令牌。
# 空 = bot 对接面禁用（路由 404 防探测）。与 bot 后端侧配置同值。
#FERRY_BOT_TOKEN=

# 调度周期旋钮（单位秒，缺省值即下行注释；改小加大后台扫描频率）：
#FERRY_HEARTBEAT_SEC=30        # agent 心跳处理
#FERRY_MONITOR_SEC=30          # 节点监控
#FERRY_EVENT_FLUSH_SEC=30      # Herald 事件 outbox 冲刷
#FERRY_REVIEW_SEC=60           # 用户到期/超限扫描
#FERRY_POOL_SEC=60             # 备池循环
#FERRY_ALLOC_SEC=300           # 分配自动换线
#FERRY_REPLENISH_SEC=300       # 备池补充
#FERRY_RECOVERY_SEC=60         # 被封恢复
#FERRY_QUOTA_LINK_SEC=600      # 配额联动
#FERRY_SAVE_STATS_SEC=600      # 省流统计
#FERRY_NOTIFY_SCAN_SEC=3600    # 站内通知扫描（到期/流量阈值）
#FERRY_PRICE_WATCH_SEC=3600    # 价格关注扫描
#FERRY_TOUCH_SEC=3600          # 入口域名例行
#FERRY_TOUCH_DOMAINS_DAYS=7    # 入口域名例行窗口（天）
#FERRY_COST_SEC=3600           # 成本聚合
