# ferry 面板部署示例配置：cp deploy/ferry.env.example deploy/ferry.env 后按需修改。
# 启动：docker compose --env-file deploy/ferry.env -f deploy/docker-compose.yml up -d --build

# 面板对外端口
FERRY_HTTP_PORT=8080

# 对外访问地址（用于拼装展示的订阅链接）
FERRY_BASE_URL=http://localhost:8080

# 存储：默认 sqlite（compose 卷 /data/ferry.db）。
# 切 postgres：取消注释并给 compose 加 --profile postgres。
#FERRY_DB_DRIVER=postgres
#FERRY_DB_DSN=postgres://ferry:改成强密码@ferry-postgres:5432/ferry?sslmode=disable
#FERRY_PG_PASSWORD=改成强密码

# 机密加密主密钥（R24 口径）：云 API 密钥等机密 AES-256-GCM 加密落库必须。
# 主密钥不入库，生成：openssl rand -hex 32；丢失即不可解密，请妥善备份。
#FERRY_SECRET_KEY=改成随机长随机串

# 供给节点 agent 安装来源（OS-3 cloud-init）：下载基址与版本。
# 内网可把基址指到自建文件服务；版本对应 release tag vX.Y.Z。
#FERRY_AGENT_BASE=https://github.com/cuihairu/ferry/releases/download
#FERRY_AGENT_VERSION=latest

# 被封自动恢复与池空保底：
# 恢复流水线（BR-1/2/3）：L1 域名前置切 DNS、L2 预备机补位、L3 一键开新机。
# 模板 ID 为 dash 供给页的机型模板，0=不启用该级；周期单位秒。
#FERRY_RECOVERY_SEC=60
#FERRY_RECOVERY_TEMPLATE_ID=0
# 池空保底（BR-3）：入口池全空且无在途供给时按模板自动开新机。
#FERRY_REPLENISH_SEC=300
#FERRY_POOL_TEMPLATE_ID=0
